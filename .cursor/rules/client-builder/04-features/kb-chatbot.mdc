## 3. Usage par projet

```tsx
// app/layout.tsx (dans le root layout, lazy loaded)
import dynamic from "next/dynamic";
const KaribotWidget = dynamic(
  () => import("@/components/chatbot/karibot-widget").then((m) => m.KaribotWidget),
  { ssr: false }
);

// PESSORA
<KaribotWidget
  name="PessoBot"
  avatarSrc="/images/pessobot-mascot.png"
  primaryColor="var(--color-noir)"
