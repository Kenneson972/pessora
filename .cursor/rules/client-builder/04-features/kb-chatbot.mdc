## 2. Composant `<KaribotWidget />`

```tsx
// components/chatbot/karibot-widget.tsx
"use client";

import { useState, useRef, useEffect } from "react";
import { usePathname } from "next/navigation";
import { X, Send, MessageCircle, Maximize2, Minimize2 } from "lucide-react";

interface Message {
  role: "user" | "assistant";
  content: string;
  timestamp?: Date;
}

interface QuickSuggestions {
  default: string[];
  [context: string]: string[];
}

interface KaribotWidgetProps {
  name: string;                          // "PessoBot", "CieloBot", "DiamantBot"
  avatarSrc: string;                     // "/images/pessobot.png"
  primaryColor?: string;                 // "var(--color-gold)" ou "#E17B5F"
  webhookUrl?: string;                   // si passé en prop (sinon env var côté /api/chat)
  quickSuggestions?: QuickSuggestions;   // suggestions rapides par contexte
  hideOnPaths?: string[];                // ["/admin", "/espace-client", "/dashboard"]
  welcomeMessage?: string;               // Message d'accueil
  placeholder?: string;                  // Placeholder input
}

const DEFAULT_SUGGESTIONS: QuickSuggestions = {
  default: ["Comment vous contacter ?", "Vos horaires ?", "Vos tarifs ?"],
};

export function KaribotWidget({
  name,
  avatarSrc,
  primaryColor = "var(--color-primary, #E17B5F)",
  quickSuggestions = DEFAULT_SUGGESTIONS,
  hideOnPaths = ["/admin", "/espace-client", "/dashboard"],
  welcomeMessage,
  placeholder = "Posez votre question...",
}: KaribotWidgetProps) {
  const [isOpen, setIsOpen] = useState(false);
  const [isFullscreen, setIsFullscreen] = useState(false);
  const [messages, setMessages] = useState<Message[]>([]);
  const [input, setInput] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const [suggestions, setSuggestions] = useState(quickSuggestions.default);
  const messagesEndRef = useRef<HTMLDivElement>(null);
  const pathname = usePathname();

  // Masquer sur certaines routes
  const isHidden = hideOnPaths.some((p) => pathname?.startsWith(p));
  if (isHidden) return null;

  // Scroll automatique
  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  // Message d'accueil à l'ouverture
  useEffect(() => {
    if (isOpen && messages.length === 0 && welcomeMessage) {
      setMessages([{
        role: "assistant",
        content: welcomeMessage,
        timestamp: new Date(),
      }]);
    }
  }, [isOpen]);

  const sendMessage = async (text: string) => {
    if (!text.trim() || isLoading) return;

    const userMsg: Message = { role: "user", content: text.trim(), timestamp: new Date() };
    setMessages((prev) => [...prev, userMsg]);
    setInput("");
    setIsLoading(true);
    setSuggestions([]); // Cacher les suggestions pendant la réponse

    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          message: text.trim(),
          history: messages.slice(-10).map((m) => ({
            role: m.role,
            content: m.content,
          })),
        }),
      });

      const data = await res.json();
      setMessages((prev) => [
        ...prev,
        { role: "assistant", content: data.response, timestamp: new Date() },
      ]);

      // Suggestions contextuelles après réponse
      const lowerResponse = data.response.toLowerCase();
      if (lowerResponse.includes("tarif") || lowerResponse.includes("prix")) {
        setSuggestions(quickSuggestions.pricing ?? quickSuggestions.default);
      } else if (lowerResponse.includes("réserv") || lowerResponse.includes("disponib")) {
        setSuggestions(quickSuggestions.booking ?? quickSuggestions.default);
      } else {
        setSuggestions(quickSuggestions.default);
      }
    } catch {
      setMessages((prev) => [
        ...prev,
        { role: "assistant", content: "Erreur de connexion. Réessayez.", timestamp: new Date() },
      ]);
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <>
      {/* FAB (bouton flottant) */}
      {!isOpen && (
        <button
          onClick={() => setIsOpen(true)}
          className="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full shadow-lg transition-transform hover:scale-110 focus:outline-none focus-visible:ring-2"
          style={{ backgroundColor: primaryColor }}
          aria-label={`Ouvrir ${name}`}
        >
          <img src={avatarSrc} alt={name} className="h-10 w-10 rounded-full object-cover" />
        </button>
      )}

      {/* Fenêtre de chat */}
      {isOpen && (
        <div
          className={`fixed z-50 flex flex-col overflow-hidden rounded-2xl bg-white shadow-2xl transition-all ${
            isFullscreen
              ? "inset-4"
              : "bottom-6 right-6 h-[520px] w-[380px] max-w-[calc(100vw-2rem)]"
          }`}
        >
          {/* Header */}
          <div
            className="flex items-center gap-3 px-4 py-3"
            style={{ backgroundColor: primaryColor }}
          >
            <img src={avatarSrc} alt={name} className="h-8 w-8 rounded-full object-cover" />
            <span className="flex-1 font-semibold text-white">{name}</span>
            <button
              onClick={() => setIsFullscreen((v) => !v)}
              className="rounded p-1 text-white/80 hover:text-white"
              aria-label={isFullscreen ? "Réduire" : "Agrandir"}
            >
              {isFullscreen ? <Minimize2 size={16} /> : <Maximize2 size={16} />}
            </button>
            <button
              onClick={() => setIsOpen(false)}
              className="rounded p-1 text-white/80 hover:text-white"
              aria-label="Fermer"
            >
              <X size={16} />
            </button>
          </div>

          {/* Messages */}
          <div className="flex-1 overflow-y-auto p-4 space-y-3">
            {messages.map((msg, i) => (
              <div
                key={i}
                className={`flex ${msg.role === "user" ? "justify-end" : "justify-start gap-2"}`}
              >
                {msg.role === "assistant" && (
                  <img src={avatarSrc} alt={name} className="h-6 w-6 flex-shrink-0 rounded-full object-cover mt-1" />
                )}
                <div
                  className={`max-w-[80%] rounded-2xl px-3 py-2 text-sm ${
                    msg.role === "user"
                      ? "rounded-br-sm text-white"
                      : "rounded-bl-sm bg-gray-100 text-gray-800"
                  }`}
                  style={msg.role === "user" ? { backgroundColor: primaryColor } : {}}
                >
                  {msg.content}
                </div>
              </div>
            ))}

            {isLoading && (
              <div className="flex items-center gap-2">
                <img src={avatarSrc} alt={name} className="h-6 w-6 rounded-full object-cover" />
                <div className="flex gap-1 rounded-2xl bg-gray-100 px-3 py-2">
                  <span className="animate-bounce h-1.5 w-1.5 rounded-full bg-gray-400" style={{ animationDelay: "0ms" }} />
                  <span className="animate-bounce h-1.5 w-1.5 rounded-full bg-gray-400" style={{ animationDelay: "150ms" }} />
                  <span className="animate-bounce h-1.5 w-1.5 rounded-full bg-gray-400" style={{ animationDelay: "300ms" }} />
                </div>
              </div>
            )}
            <div ref={messagesEndRef} />
          </div>

          {/* Suggestions rapides */}
          {suggestions.length > 0 && !isLoading && (
            <div className="flex flex-wrap gap-2 px-4 pb-2">
              {suggestions.map((s) => (
                <button
                  key={s}
                  onClick={() => sendMessage(s)}
                  className="rounded-full border border-gray-200 px-3 py-1 text-xs text-gray-600 hover:border-gray-400 transition-colors"
                >
                  {s}
                </button>
              ))}
            </div>
          )}

          {/* Input */}
          <div className="flex items-center gap-2 border-t border-gray-100 px-3 py-3">
            <input
              type="text"
              value={input}
              onChange={(e) => setInput(e.target.value)}
              onKeyDown={(e) => e.key === "Enter" && !e.shiftKey && sendMessage(input)}
              placeholder={placeholder}
              className="flex-1 rounded-full border border-gray-200 bg-gray-50 px-4 py-2 text-sm outline-none focus:border-gray-400"
              disabled={isLoading}
            />
            <button
              onClick={() => sendMessage(input)}
              disabled={!input.trim() || isLoading}
              className="flex h-9 w-9 items-center justify-center rounded-full text-white transition-opacity disabled:opacity-40"
              style={{ backgroundColor: primaryColor }}
              aria-label="Envoyer"
            >
              <Send size={16} />
            </button>
          </div>
        </div>
      )}
    </>
  );
}
```

