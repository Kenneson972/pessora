## 4. Usage dans un Route Handler

```ts
// app/api/contact/route.ts
import { resend, FROM } from "@/lib/resend";
import { leadNotificationHtml } from "@/lib/emails/templates";

export async function POST(req: Request) {
  const { name, email, phone, message } = await req.json();

  // 1. Notifier le client (admin)
  await resend?.emails.send({
    from: FROM,
    to: [process.env.ADMIN_EMAIL ?? "contact@client.fr"],
    subject: `Nouveau contact de ${name}`,
    html: leadNotificationHtml({ name, email, phone, message, clientName: "Mon Client" }),
  });

  // 2. Accuser réception au visiteur (optionnel)
  await resend?.emails.send({
    from: FROM,
    to: [email],
    subject: "Nous avons bien reçu votre message",
    html: `<p style="font-family:Georgia,serif;font-size:15px;color:#334155">
      Bonjour ${name},<br /><br />
      Nous avons bien reçu votre message et vous recontacterons sous 48h.<br /><br />
      À bientôt.
    </p>`,
  });

  return Response.json({ ok: true });
}
```

