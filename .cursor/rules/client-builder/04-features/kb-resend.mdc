## 3. Templates HTML inline

### Style de base partagé (copier dans chaque template)

```ts
const BASE_STYLE = `font-family:Georgia,serif;max-width:520px;margin:0 auto;color:#1a1a1a`;
const MUTED = `font-size:12px;color:#94a3b8`;
const BODY = `font-size:15px;line-height:1.7;color:#334155`;
const HR = `border:none;border-top:1px solid #e2e8f0;margin:24px 0`;
```

### Confirmation de réservation

```ts
export function bookingConfirmationHtml(data: {
  guestName: string;
  villaName: string;
  startDate: string;
  endDate: string;
  totalPrice: number;
  clientName: string;
}) {
  return `
    <div style="${BASE_STYLE}">
      <h2 style="font-weight:400">${data.clientName}</h2>
      <p style="${BODY}">Bonjour ${data.guestName},</p>
      <p style="${BODY}">
        Votre réservation pour <strong>${data.villaName}</strong> est confirmée.
      </p>
      <table style="width:100%;border-collapse:collapse;margin:16px 0">
        <tr>
          <td style="${BODY};padding:8px 0;border-bottom:1px solid #f1f5f9">Arrivée</td>
          <td style="${BODY};padding:8px 0;border-bottom:1px solid #f1f5f9;text-align:right"><strong>${data.startDate}</strong></td>
        </tr>
        <tr>
          <td style="${BODY};padding:8px 0;border-bottom:1px solid #f1f5f9">Départ</td>
          <td style="${BODY};padding:8px 0;border-bottom:1px solid #f1f5f9;text-align:right"><strong>${data.endDate}</strong></td>
        </tr>
        <tr>
          <td style="${BODY};padding:8px 0">Total</td>
          <td style="${BODY};padding:8px 0;text-align:right"><strong>${data.totalPrice.toLocaleString("fr-FR")} €</strong></td>
        </tr>
      </table>
      <hr style="${HR}" />
      <p style="${MUTED}">
        ${data.clientName} — cet email a été envoyé automatiquement, merci de ne pas y répondre.
      </p>
    </div>
  `;
}
```

### Confirmation de commande (e-commerce)

```ts
export function orderConfirmationHtml(data: {
  customerName: string;
  orderToken: string;
  items: { name: string; qty: number; price: number }[];
  total: number;
  trackingUrl: string;
  clientName: string;
}) {
  const rows = data.items
    .map(
      (i) => `
      <tr>
        <td style="${BODY};padding:8px 0;border-bottom:1px solid #f1f5f9">${i.name} ×${i.qty}</td>
        <td style="${BODY};padding:8px 0;border-bottom:1px solid #f1f5f9;text-align:right">${(i.price * i.qty).toFixed(2)} €</td>
      </tr>`
    )
    .join("");

  return `
    <div style="${BASE_STYLE}">
      <h2 style="font-weight:400">${data.clientName}</h2>
      <p style="${BODY}">Merci ${data.customerName}, votre commande est confirmée.</p>
      <table style="width:100%;border-collapse:collapse;margin:16px 0">
        ${rows}
        <tr>
          <td style="${BODY};padding:8px 0;font-weight:600">Total</td>
          <td style="${BODY};padding:8px 0;text-align:right;font-weight:600">${data.total.toFixed(2)} €</td>
        </tr>
      </table>
      <a href="${data.trackingUrl}"
         style="display:inline-block;margin-top:16px;padding:12px 24px;background:#1a1a1a;color:#fff;text-decoration:none;border-radius:4px;font-size:14px">
        Suivre ma commande
      </a>
      <hr style="${HR}" />
      <p style="${MUTED}">
        Référence : ${data.orderToken}<br />
        ${data.clientName} — ne pas répondre à cet email.
      </p>
    </div>
  `;
}
```

### Notification lead (formulaire de contact)

```ts
export function leadNotificationHtml(data: {
  name: string;
  email: string;
  phone?: string;
  message: string;
  source?: string;
  clientName: string;
}) {
  return `
    <div style="${BASE_STYLE}">
      <h2 style="font-weight:400">Nouveau contact — ${data.clientName}</h2>
      <table style="width:100%;border-collapse:collapse;margin:16px 0">
        <tr><td style="${BODY};padding:6px 0"><strong>Nom</strong></td><td style="${BODY};padding:6px 0">${data.name}</td></tr>
        <tr><td style="${BODY};padding:6px 0"><strong>Email</strong></td><td style="${BODY};padding:6px 0"><a href="mailto:${data.email}">${data.email}</a></td></tr>
        ${data.phone ? `<tr><td style="${BODY};padding:6px 0"><strong>Téléphone</strong></td><td style="${BODY};padding:6px 0">${data.phone}</td></tr>` : ""}
        ${data.source ? `<tr><td style="${BODY};padding:6px 0"><strong>Source</strong></td><td style="${BODY};padding:6px 0">${data.source}</td></tr>` : ""}
      </table>
      <p style="${BODY};background:#f8fafc;padding:16px;border-left:3px solid #e2e8f0">${data.message}</p>
    </div>
  `;
}
```

