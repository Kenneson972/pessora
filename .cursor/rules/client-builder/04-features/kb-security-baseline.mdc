## Utiliser `requireAdminWithRateLimit` dans chaque route admin

```ts
// app/api/admin/products/route.ts
import { requireAdminWithRateLimit } from "@/lib/adminAuth";
import { logAdminAction } from "@/lib/auditLog";
import { getIp } from "@/lib/rateLimit";

export async function POST(req: Request) {
  const authError = requireAdminWithRateLimit(req);
  if (authError) return authError;

  // ... logique métier ...

  await logAdminAction("product.create", { name: data.name }, getIp(req));
  return NextResponse.json({ ok: true });
}
```

